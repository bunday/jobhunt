# ---------- AI (required: pick ONE provider) ----------
# Used for importing your CV, tailoring CVs, writing cover letters and polishing answers.

# Option 1: Anthropic API key (https://console.anthropic.com)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# AI_MODEL=claude-opus-5            # default

# Option 2: any OpenAI-compatible API: OpenAI, OpenRouter, Gemini, Groq, Mistral, or a local Ollama
# AI_PROVIDER=openai
# AI_API_KEY=
# AI_MODEL=gpt-5                     # required, e.g. gpt-5, google/gemini-2.5-pro, llama3.1
# AI_BASE_URL=https://api.openai.com/v1
#   OpenRouter: https://openrouter.ai/api/v1
#   Gemini:     https://generativelanguage.googleapis.com/v1beta/openai
#   Ollama:     http://host.docker.internal:11434/v1   (no key needed)

# Option 3: a Claude subscription through Claude Code (run `claude setup-token` to get a token)
# AI_PROVIDER=claude-cli
# CLAUDE_CODE_OAUTH_TOKEN=
# INSTALL_CLAUDE_CLI=true            # installs Claude Code in the image at build time

# ---------- Optional ----------
# Adzuna job search API (free key: https://developer.adzuna.com): more job boards in the UK, NL, US and Canada
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# Port the app runs on, and your time zone (the daily search runs at the hour set in Settings)
PORT=3800
TZ=Europe/London
