{
  "name": "jobhunt",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Self-hosted job search assistant: scans job boards, ranks jobs against your CV, tailors CVs and cover letters with the AI of your choice, and tracks your applications.",
  "scripts": {
    "dev": "bun run --hot src/index.ts",
    "dev:web": "vite",
    "build:web": "vite build",
    "scan": "bun run src/scan.ts",
    "check": "tsc --noEmit -p . && tsc --noEmit -p web"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.128.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "elysia": "^1.1.0",
    "lucide-react": "^1.48.0",
    "react": "^18.3",
    "react-dom": "^18.3",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "^1.1.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^5",
    "vite": "^5.4.0"
  },
  "license": "MIT"
}
